{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "motion-broll-pro plan",
  "type": "object",
  "required": ["meta", "video", "beats", "assets", "render"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["inputMode", "energy", "language", "paletteSource"],
      "properties": {
        "inputMode": {"type": "string", "enum": ["raw_video", "script", "voiceover"]},
        "energy": {"type": "string", "enum": ["high", "medium"], "default": "high"},
        "language": {"type": "string", "enum": ["bn", "en", "mixed"]},
        "paletteSource": {"type": "string", "description": "sampled_from_input | user_provided | default_navy"},
        "palette": {
          "type": "object",
          "required": ["bg", "primary", "accent", "accent2"],
          "properties": {
            "bg": {"type": "string", "pattern": "^#([0-9a-fA-F]{6})$"},
            "primary": {"type": "string", "pattern": "^#([0-9a-fA-F]{6})$"},
            "accent": {"type": "string", "pattern": "^#([0-9a-fA-F]{6})$"},
            "accent2": {"type": "string", "pattern": "^#([0-9a-fA-F]{6})$"},
            "maxPurpleRatio": {"type": "number", "maximum": 0.25}
          }
        }
      }
    },
    "video": {
      "type": "object",
      "required": ["W", "H", "fps", "duration", "bpm"],
      "properties": {
        "W": {"type": "integer", "enum": [2560, 1920, 1280]},
        "H": {"type": "integer", "enum": [1440, 1080, 720]},
        "fps": {"type": "integer", "enum": [25, 30, 60]},
        "duration": {"type": "number", "minimum": 8, "maximum": 140},
        "bpm": {"type": "integer", "minimum": 90, "maximum": 140}
      }
    },
    "beats": {
      "type": "array",
      "minItems": 5,
      "maxItems": 9,
      "items": {
        "type": "object",
        "required": ["id", "tIn", "tOut", "line", "lang", "template", "visual", "SH", "SEQ", "layers"],
        "properties": {
          "id": {"type": "string", "pattern": "^[0-9]{2}-[a-z0-9-]+$"},
          "tIn": {"type": "number", "minimum": 0},
          "tOut": {"type": "number"},
          "line": {"type": "string", "minLength": 4},
          "lang": {"type": "string", "enum": ["bn", "en"]},
          "template": {"type": "string", "enum": ["pill", "phone", "grid", "ribbon", "split", "wipe", "terminal", "dashboard"]},
          "visual": {"type": "string", "description": "What is seen"},
          "maxHold": {"type": "number", "description": "Must be <=1.4 high, <=4.0 medium"},
          "SH": {"type": "object", "description": "Shape definitions {name:{w,h,r,bg,cam}}"},
          "SEQ": {"type": "array", "items": {"type": "array", "minItems": 2, "maxItems": 2}},
          "layers": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["el", "tin", "tout"],
              "properties": {
                "el": {"type": "string"},
                "tin": {"type": "number"},
                "tout": {"type": "number"},
                "o": {"type": "object"}
              }
            }
          },
          "sfx": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["type", "at"],
              "properties": {
                "type": {"type": "string", "enum": ["whoosh", "pop", "shutter", "tick", "chime", "hit"]},
                "at": {"type": "number"},
                "file": {"type": "string"}
              }
            }
          }
        }
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "query", "beatId", "reason"],
        "properties": {
          "id": {"type": "string"},
          "type": {"type": "string", "enum": ["fetch", "generate", "mock"]},
          "query": {"type": "string"},
          "beatId": {"type": "string"},
          "reason": {"type": "string"},
          "fallback": {"type": "string", "enum": ["generate", "mock", "none"]},
          "expectedPath": {"type": "string"}
        }
      }
    },
    "render": {
      "type": "object",
      "required": ["clips", "final"],
      "properties": {
        "clips": {"type": "array", "items": {"type": "string"}},
        "final": {"type": "string", "pattern": "^output/final\\.mp4$"},
        "transparentPanels": {"type": "boolean"}
      }
    }
  },
  "additionalProperties": false
}
